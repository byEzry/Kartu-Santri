# ==============================================================================
# CONTOH TEMPLATE KONFIGURASI (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS       : cp .env.example .env
# ==============================================================================

# Port Backend Server (Express)
PORT=5000

# Lingkungan Kerja Aplikasi: development | production | test
NODE_ENV=development

# Salt Pengacak Password Hash (SHA-256)
PASSWORD_SALT=_salt_pesantren_2026

# Origin CORS yang diizinkan (* untuk mengizinkan semua laptop/PC di jaringan LAN)
CORS_ORIGIN=*

# Batas Maksimum Upload Berkas dalam Bytes (52428800 = 50 MB)
MAX_FILE_SIZE_BYTES=52428800

# Port Vite Frontend
VITE_PORT=3000
